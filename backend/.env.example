# Copy this file to backend/.env and adjust values for local development.
AGENTFLOW_APP_NAME=AgentFlow API
AGENTFLOW_APP_VERSION=0.1.0
AGENTFLOW_ENVIRONMENT=development
AGENTFLOW_HOST=127.0.0.1
AGENTFLOW_PORT=8000
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Relative paths are resolved from the backend directory.
AGENTFLOW_DATA_DIR=data
AGENTFLOW_DATABASE_PATH=data/agentflow.db

# Configure one OpenAI-compatible chat completion endpoint. Do not commit real secrets.
AGENTFLOW_MODEL_API_BASE=
AGENTFLOW_MODEL_API_KEY=
AGENTFLOW_MODEL_NAME=
AGENTFLOW_MODEL_TIMEOUT_SECONDS=60

# Reserved for the web-search phase; do not commit real secrets.
AGENTFLOW_SEARCH_API_KEY=

AGENTFLOW_MAX_UPLOAD_SIZE_MB=20
AGENTFLOW_MAX_ARTIFACT_SIZE_MB=5
AGENTFLOW_MAX_AGENT_LOOPS=10
AGENTFLOW_TOOL_TIMEOUT_SECONDS=30
AGENTFLOW_WEB_FETCH_TIMEOUT_SECONDS=10
